10 OPTION ANGLE RADIANS
20 DIM U(319),L(319)
30 GRAPH
40 SCALE 0,319,0,239
50 PEN 3
60 FOR I=0 TO 319
70 U(I)=0
80 L(I)=239
90 NEXT I
100 FOR Y=-9 TO 9 STEP .75
110 P=0
120 FOR X=-9 TO 9 STEP .25
130 R=SQR(X*X+Y*Y)
140 Z=1
150 IF R THEN Z=SIN(R)/R
160 S=160+10*X+2.5*Y
170 T=110+4*Y+60*Z
180 I=IP(S+.5)
190 V=(SGN(T-U(I))=1) OR (SGN(L(I)-T)=1)
200 U(I)=MAX(U(I),T)
210 L(I)=MIN(L(I),T)
220 IF V AND P THEN DRAW S,T ELSE MOVE S,T
230 P=V
240 NEXT X
250 NEXT Y
