10 OPTION ANGLE RADIANS
20 DIM P(1500),Q(1500),R(1500)
30 DISP "INTEGRATING LORENZ"
40 A=1 @ B=1 @ C=1 @ H=.005
50 FOR I=1 TO 100 @ GOSUB 500 @ NEXT I
60 FOR I=1 TO 1500 @ GOSUB 500 @ P(I)=A @ Q(I)=B @ R(I)=C @ NEXT I
70 GRAPH
80 SCALE 0,799,0,599
90 FOR F=0 TO 15
100 T=F*PI/8 @ C1=COS(T) @ S1=SIN(T)
110 GTARGET F @ GCLEAR
120 FOR I=1 TO 1500
130 U=P(I)*C1-Q(I)*S1 @ V=P(I)*S1+Q(I)*C1
140 X=400+12*U @ Y=300+8*(R(I)-25)+2.5*V
150 PEN 2+MOD(IP(I/50),6)
160 IF I=1 THEN MOVE X,Y ELSE DRAW X,Y
170 NEXT I
180 DISP "FRAME";F
190 NEXT F
200 FOR F=0 TO 15 @ GSHOW F @ WAIT .15 @ NEXT F
210 GOTO 200
500 FOR K=1 TO 4
510 D=10*(B-A) @ E=A*(28-C)-B @ G=A*B-8*C/3
520 A=A+H*D @ B=B+H*E @ C=C+H*G
530 NEXT K
540 RETURN
