10 OPTION ANGLE RADIANS
20 DIM U(799),L(799)
30 GRAPH
40 SCALE 0,799,0,599
50 FOR F=0 TO 11
60 GTARGET F+1
70 GCLEAR
80 FOR I=0 TO 799 @ U(I)=0 @ L(I)=599 @ NEXT I
90 FOR Y=-9 TO 9 STEP .75
100 P=0
110 FOR X=-9 TO 9 STEP .25
120 R=SQR(X*X+Y*Y)
130 Z=1.5*SIN(R+1.5-F*PI/6)/(R+1.5)
140 A=ATN(Y/(X+1E-9))
150 IF X<0 THEN A=A+PI
160 PEN 2+MOD(IP((A+PI/2)*6/PI)+F,6)
170 S=400+22*X+5.5*Y
180 T=300+9*Y+150*Z
190 I=IP(S+.5)
200 V=(SGN(T-U(I))=1) OR (SGN(L(I)-T)=1)
210 U(I)=MAX(U(I),T) @ L(I)=MIN(L(I),T)
220 IF V AND P THEN DRAW S,T ELSE MOVE S,T
230 P=V
240 NEXT X
250 NEXT Y
260 NEXT F
270 FOR F=1 TO 12
280 GSHOW F
290 WAIT .5
300 NEXT F
310 GOTO 270
